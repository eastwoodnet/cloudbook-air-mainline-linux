--- build/6.12-v7/dw_wdt.c.orig	2026-11-11 09:01:11.000000000 +0800
+++ linux-6.12/drivers/watchdog/dw_wdt.c	2026-11-12 20:17:45.423805166 +0800
@@ -27,6 +27,7 @@
 #include <linux/platform_device.h>
 #include <linux/pm.h>
 #include <linux/reset.h>
+#include <linux/timer.h>
 #include <linux/watchdog.h>
 
 #define WDOG_CONTROL_REG_OFFSET		    0x00
@@ -99,6 +100,63 @@
 
 #define to_dw_wdt(wdd)	container_of(wdd, struct dw_wdt, wdd)
 
+/*
+ * CloudBook Air bring-up diagnostic: the vendor bootloader may hand over an
+ * already-running DW watchdog, while the built-in driver only probes at
+ * device_initcall level.  Read the block at arch_initcall time and, if it is
+ * armed, keep it alive so one boot can distinguish a watchdog reset from a
+ * PMIC/EC reset.
+ */
+#define DW_WDT_EARLY_PHYS	0xfe600000
+
+static void __iomem *dw_wdt_early_base;
+static struct timer_list dw_wdt_early_timer;
+static unsigned int dw_wdt_early_ticks;
+
+static void dw_wdt_early_tick(struct timer_list *t)
+{
+	u32 cr = readl(dw_wdt_early_base + WDOG_CONTROL_REG_OFFSET);
+	u32 torr = readl(dw_wdt_early_base + WDOG_TIMEOUT_RANGE_REG_OFFSET);
+	u32 ccvr = readl(dw_wdt_early_base + WDOG_CURRENT_COUNT_REG_OFFSET);
+
+	if (!(dw_wdt_early_ticks++ % 10))
+		pr_info("dw_wdt_early: t=%llu cr=%08x torr=%08x ccvr=%08x\n",
+			ktime_get_ns(), cr, torr, ccvr);
+
+	writel(WDOG_COUNTER_RESTART_KICK_VALUE,
+	       dw_wdt_early_base + WDOG_COUNTER_RESTART_REG_OFFSET);
+	mod_timer(t, jiffies + msecs_to_jiffies(100));
+}
+
+static int __init dw_wdt_early_diag(void)
+{
+	u32 cr, torr, ccvr, comp1;
+
+	dw_wdt_early_base = ioremap(DW_WDT_EARLY_PHYS, 0x100);
+	if (!dw_wdt_early_base)
+		return 0;
+
+	cr = readl(dw_wdt_early_base + WDOG_CONTROL_REG_OFFSET);
+	torr = readl(dw_wdt_early_base + WDOG_TIMEOUT_RANGE_REG_OFFSET);
+	ccvr = readl(dw_wdt_early_base + WDOG_CURRENT_COUNT_REG_OFFSET);
+	comp1 = readl(dw_wdt_early_base + WDOG_COMP_PARAMS_1_REG_OFFSET);
+
+	pr_info("dw_wdt_early: t=%llu cr=%08x torr=%08x ccvr=%08x comp1=%08x\n",
+		ktime_get_ns(), cr, torr, ccvr, comp1);
+
+	if (cr & WDOG_CONTROL_REG_WDT_EN_MASK) {
+		pr_warn("dw_wdt_early: WDT is already enabled, feeding every 100ms\n");
+		writel(WDOG_COUNTER_RESTART_KICK_VALUE,
+		       dw_wdt_early_base + WDOG_COUNTER_RESTART_REG_OFFSET);
+		timer_setup(&dw_wdt_early_timer, dw_wdt_early_tick, 0);
+		mod_timer(&dw_wdt_early_timer,
+			  jiffies + msecs_to_jiffies(100));
+	}
+
+	return 0;
+}
+arch_initcall(dw_wdt_early_diag);
+
