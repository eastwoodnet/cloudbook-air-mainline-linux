From: CloudBook Air Linux Port <port@cloudbookair.local>
Subject: [PATCH] drm: rockchip: add RK3568 Analogix eDP and BOE NV140WUM-N44 support

Add RK3568 eDP binding/power-on training return propagation in
analogix_dp and register BOE 0x0a6a (NV140WUM-N44) in panel-edp.
---
diff --git a/include/drm/bridge/analogix_dp.h b/include/drm/bridge/analogix_dp.h
--- a/include/drm/bridge/analogix_dp.h
+++ b/include/drm/bridge/analogix_dp.h
@@ -16,12 +16,14 @@
 	EXYNOS_DP,
 	RK3288_DP,
 	RK3399_EDP,
+	RK3568_EDP,
 	RK3588_EDP,
 };
 
 static inline bool is_rockchip(enum analogix_dp_devtype type)
 {
-	return type == RK3288_DP || type == RK3399_EDP || type == RK3588_EDP;
+	return type == RK3288_DP || type == RK3399_EDP ||
+		type == RK3568_EDP || type == RK3588_EDP;
 }
 
 struct analogix_dp_plat_data {
diff --git a/drivers/gpu/drm/bridge/analogix/analogix_dp_core.h b/drivers/gpu/drm/bridge/analogix/analogix_dp_core.h
--- a/drivers/gpu/drm/bridge/analogix/analogix_dp_core.h
+++ b/drivers/gpu/drm/bridge/analogix/analogix_dp_core.h
@@ -200,15 +200,15 @@
 void analogix_dp_init_aux(struct analogix_dp_device *dp);
 int analogix_dp_get_plug_in_status(struct analogix_dp_device *dp);
 void analogix_dp_enable_sw_function(struct analogix_dp_device *dp);
-void analogix_dp_set_link_bandwidth(struct analogix_dp_device *dp, u32 bwtype);
+int analogix_dp_set_link_bandwidth(struct analogix_dp_device *dp, u32 bwtype);
 void analogix_dp_get_link_bandwidth(struct analogix_dp_device *dp, u32 *bwtype);
-void analogix_dp_set_lane_count(struct analogix_dp_device *dp, u32 count);
+int analogix_dp_set_lane_count(struct analogix_dp_device *dp, u32 count);
 void analogix_dp_get_lane_count(struct analogix_dp_device *dp, u32 *count);
 void analogix_dp_enable_enhanced_mode(struct analogix_dp_device *dp,
 				      bool enable);
 void analogix_dp_set_training_pattern(struct analogix_dp_device *dp,
 				      enum pattern_set pattern);
-void analogix_dp_set_lane_link_training(struct analogix_dp_device *dp);
+int analogix_dp_set_lane_link_training(struct analogix_dp_device *dp);
 u32 analogix_dp_get_lane_link_training(struct analogix_dp_device *dp, u8 lane);
 void analogix_dp_reset_macro(struct analogix_dp_device *dp);
 void analogix_dp_init_video(struct analogix_dp_device *dp);
diff --git a/drivers/gpu/drm/bridge/analogix/analogix_dp_core.c b/drivers/gpu/drm/bridge/analogix/analogix_dp_core.c
--- a/drivers/gpu/drm/bridge/analogix/analogix_dp_core.c
+++ b/drivers/gpu/drm/bridge/analogix/analogix_dp_core.c
@@ -237,7 +237,9 @@
 		dp->link_train.cr_loop[lane] = 0;
 
 	/* Set link rate and count as you want to establish*/
-	analogix_dp_set_link_bandwidth(dp, dp->link_train.link_rate);
+	retval = analogix_dp_set_link_bandwidth(dp, dp->link_train.link_rate);
+	if (retval)
+		return retval;
 	retval = analogix_dp_wait_pll_locked(dp);
 	if (retval) {
 		DRM_DEV_ERROR(dp->dev, "Wait for pll lock failed %d\n", retval);
@@ -248,7 +250,9 @@
 	 * the DP inter pair skew issue for at least 10 us
 	 */
 	analogix_dp_reset_macro(dp);
-	analogix_dp_set_lane_count(dp, dp->link_train.lane_count);
+	retval = analogix_dp_set_lane_count(dp, dp->link_train.lane_count);
+	if (retval)
+		return retval;
 
 	/* Setup RX configuration */
 	buf[0] = dp->link_train.link_rate;
@@ -268,7 +272,9 @@
 		dp->link_train.training_lane[lane] =
 					DP_TRAIN_VOLTAGE_SWING_LEVEL_0 |
 					DP_TRAIN_PRE_EMPH_LEVEL_0;
-	analogix_dp_set_lane_link_training(dp);
+	retval = analogix_dp_set_lane_link_training(dp);
+	if (retval)
+		return retval;
 
 	/* Set training pattern 1 */
 	analogix_dp_set_training_pattern(dp, TRAINING_PTN1);
@@ -439,7 +445,9 @@
 	}
 
 	analogix_dp_get_adjust_training_lane(dp, adjust_request);
-	analogix_dp_set_lane_link_training(dp);
+	retval = analogix_dp_set_lane_link_training(dp);
+	if (retval)
+		return retval;
 
 	retval = drm_dp_dpcd_write(&dp->aux, DP_TRAINING_LANE0_SET,
 				   dp->link_train.training_lane, lane_count);
@@ -511,7 +519,9 @@
 		return -EIO;
 	}
 
-	analogix_dp_set_lane_link_training(dp);
+	retval = analogix_dp_set_lane_link_training(dp);
+	if (retval)
+		return retval;
 
 	retval = drm_dp_dpcd_write(&dp->aux, DP_TRAINING_LANE0_SET,
 				   dp->link_train.training_lane, lane_count);
@@ -620,7 +630,9 @@
 	int ret;
 	u8 link_align, link_status[2];
 
-	analogix_dp_set_link_bandwidth(dp, dp->link_train.link_rate);
+	ret = analogix_dp_set_link_bandwidth(dp, dp->link_train.link_rate);
+	if (ret)
+		return ret;
 	ret = analogix_dp_wait_pll_locked(dp);
 	if (ret) {
 		DRM_DEV_ERROR(dp->dev, "Wait for pll lock failed %d\n", ret);
@@ -632,8 +644,12 @@
 	 * the DP inter pair skew issue for at least 10 us
 	 */
 	analogix_dp_reset_macro(dp);
-	analogix_dp_set_lane_count(dp, dp->link_train.lane_count);
-	analogix_dp_set_lane_link_training(dp);
+	ret = analogix_dp_set_lane_count(dp, dp->link_train.lane_count);
+	if (ret)
+		return ret;
+	ret = analogix_dp_set_lane_link_training(dp);
+	if (ret)
+		return ret;
 
 	/* source Set training pattern 1 */
 	analogix_dp_set_training_pattern(dp, TRAINING_PTN1);
@@ -1507,6 +1523,7 @@
 	switch (dp->plat_data->dev_type) {
 	case RK3288_DP:
 	case RK3399_EDP:
+	case RK3568_EDP:
 		/*
 		 * Like Rk3288 DisplayPort TRM indicate that "Main link
 		 * containing 4 physical lanes of 2.7/1.62 Gbps/lane".
diff --git a/drivers/gpu/drm/bridge/analogix/analogix_dp_reg.c b/drivers/gpu/drm/bridge/analogix/analogix_dp_reg.c
--- a/drivers/gpu/drm/bridge/analogix/analogix_dp_reg.c
+++ b/drivers/gpu/drm/bridge/analogix/analogix_dp_reg.c
@@ -11,6 +11,7 @@
 #include <linux/gpio/consumer.h>
 #include <linux/io.h>
 #include <linux/iopoll.h>
+#include <linux/phy/phy.h>
 
 #include <drm/bridge/analogix_dp.h>
 
@@ -510,13 +511,31 @@
 	writel(reg, dp->reg_base + ANALOGIX_DP_FUNC_EN_1);
 }
 
-void analogix_dp_set_link_bandwidth(struct analogix_dp_device *dp, u32 bwtype)
-{
-	u32 reg;
+int analogix_dp_set_link_bandwidth(struct analogix_dp_device *dp, u32 bwtype)
+{
+	u32 reg;
+	int ret;
 
 	reg = bwtype;
 	if ((bwtype == DP_LINK_BW_2_7) || (bwtype == DP_LINK_BW_1_62))
 		writel(reg, dp->reg_base + ANALOGIX_DP_LINK_BW_SET);
+
+	if (dp->phy) {
+		union phy_configure_opts phy_cfg = {0};
+
+		phy_cfg.dp.lanes = dp->link_train.lane_count;
+		phy_cfg.dp.link_rate =
+			drm_dp_bw_code_to_link_rate(dp->link_train.link_rate) / 100;
+		phy_cfg.dp.set_rate = true;
+		ret = phy_configure(dp->phy, &phy_cfg);
+		if (ret && ret != -EOPNOTSUPP) {
+			dev_err(dp->dev, "%s: phy_configure() failed: %d\n",
+				__func__, ret);
+			return ret;
+		}
+	}
+
+	return 0;
 }
 
 void analogix_dp_get_link_bandwidth(struct analogix_dp_device *dp, u32 *bwtype)
@@ -527,12 +546,28 @@
 	*bwtype = reg;
 }
 
-void analogix_dp_set_lane_count(struct analogix_dp_device *dp, u32 count)
-{
-	u32 reg;
+int analogix_dp_set_lane_count(struct analogix_dp_device *dp, u32 count)
+{
+	u32 reg;
+	int ret;
 
 	reg = count;
 	writel(reg, dp->reg_base + ANALOGIX_DP_LANE_COUNT_SET);
+
+	if (dp->phy) {
+		union phy_configure_opts phy_cfg = {0};
+
+		phy_cfg.dp.lanes = dp->link_train.lane_count;
+		phy_cfg.dp.set_lanes = true;
+		ret = phy_configure(dp->phy, &phy_cfg);
+		if (ret && ret != -EOPNOTSUPP) {
+			dev_err(dp->dev, "%s: phy_configure() failed: %d\n",
+				__func__, ret);
+			return ret;
+		}
+	}
+
+	return 0;
 }
 
 void analogix_dp_get_lane_count(struct analogix_dp_device *dp, u32 *count)
@@ -543,13 +578,41 @@
 	*count = reg;
 }
 
-void analogix_dp_set_lane_link_training(struct analogix_dp_device *dp)
+int analogix_dp_set_lane_link_training(struct analogix_dp_device *dp)
 {
 	u8 lane;
+	int ret;
 
 	for (lane = 0; lane < dp->link_train.lane_count; lane++)
 		writel(dp->link_train.training_lane[lane],
 		       dp->reg_base + ANALOGIX_DP_LN0_LINK_TRAINING_CTL + 4 * lane);
+
+	if (dp->phy) {
+		union phy_configure_opts phy_cfg = {0};
+
+		for (lane = 0; lane < dp->link_train.lane_count; lane++) {
+			u8 training_lane = dp->link_train.training_lane[lane];
+			u8 vs, pe;
+
+			vs = (training_lane & DP_TRAIN_VOLTAGE_SWING_MASK) >>
+			     DP_TRAIN_VOLTAGE_SWING_SHIFT;
+			pe = (training_lane & DP_TRAIN_PRE_EMPHASIS_MASK) >>
+			     DP_TRAIN_PRE_EMPHASIS_SHIFT;
+			phy_cfg.dp.voltage[lane] = vs;
+			phy_cfg.dp.pre[lane] = pe;
+		}
+
+		phy_cfg.dp.lanes = dp->link_train.lane_count;
+		phy_cfg.dp.set_voltages = true;
+		ret = phy_configure(dp->phy, &phy_cfg);
+		if (ret && ret != -EOPNOTSUPP) {
+			dev_err(dp->dev, "%s: phy_configure() failed: %d\n",
+				__func__, ret);
+			return ret;
+		}
+	}
+
+	return 0;
 }
 
 u32 analogix_dp_get_lane_link_training(struct analogix_dp_device *dp, u8 lane)
